<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Exam timer</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root{
    --bg:#ffffff;
    --ink:#0a0a0a;
    --muted:#6b7280;
    --line:#e5e7eb;
    --chip:#f3f4f6;
    --blue:#1d6ff2;
    --red:#d92f2f;
    --green:#0f7a54;
    --green-bg:#f2fbf7;
    --pause-bg:#fafafa;
    --radius:10px;
  }
  @media (prefers-color-scheme: dark){
    :root{
      --bg:#0b0b0c; --ink:#f5f5f5; --muted:#9ca3af; --line:#26272b;
      --chip:#1a1b1e; --blue:#4d8ffb; --red:#ff6b6b; --green:#3ddc9a; --green-bg:#0e1a15; --pause-bg:#121214;
    }
  }

  *{box-sizing:border-box}
  html,body{height:100%}
  body{
    margin:0;
    background:var(--bg);
    color:var(--ink);
    font-family:"Inter", system-ui, -apple-system, "Segoe UI", sans-serif;
    -webkit-font-smoothing:antialiased;
    transition:background-color .35s ease;
  }
  body.is-break{background:var(--green-bg)}
  body.is-paused{background:var(--pause-bg)}

  #progress{position:fixed;top:0;left:0;height:3px;width:0;background:var(--blue);transition:width .3s linear,background-color .3s ease;z-index:5}
  body.is-break #progress{background:var(--green)}
  body.is-paused #progress{background:var(--muted)}

  .wrap{min-height:100%;display:flex;flex-direction:column;align-items:center;padding:48px 20px 24px;text-align:center}

  /* ---------- Setup ---------- */
  .setup{width:100%;max-width:480px;margin:auto 0;text-align:left}
  .setup h1{font-size:26px;font-weight:700;letter-spacing:-.02em;margin:0 0 4px}
  .setup .lede{color:var(--muted);font-size:15px;margin:0 0 28px;line-height:1.5}
  .field{margin-bottom:18px}
  label{display:block;font-size:13px;font-weight:600;margin-bottom:6px}
  .hint{display:block;font-weight:400;color:var(--muted);font-size:12.5px;margin-top:4px;line-height:1.45}
  input[type=text],input[type=date],input[type=number]{
    width:100%;padding:11px 12px;font:inherit;font-size:15px;color:var(--ink);
    background:var(--bg);border:1px solid var(--line);border-radius:var(--radius);
  }
  input:focus-visible{outline:2px solid var(--blue);outline-offset:1px;border-color:transparent}
  .duo{display:flex;gap:10px}
  .duo>div{flex:1}
  .unit{flex:0 0 auto;display:flex;align-items:center;color:var(--muted);font-size:14px}
  .allowance{
    border:1px solid var(--line);border-radius:var(--radius);padding:14px 16px;margin:24px 0 22px;background:var(--chip);
  }
  .allowance .big{font-size:19px;font-weight:600;letter-spacing:-.01em}
  .allowance .note{font-size:12.5px;color:var(--muted);margin-top:5px;line-height:1.5}
  .err{color:var(--red);font-size:13px;font-weight:500;margin:-8px 0 14px}

  /* ---------- Timer screen ---------- */
  .screen{width:100%;max-width:900px;margin:auto 0}
  .course{font-size:clamp(26px,4.6vw,38px);font-weight:700;letter-spacing:-.025em;margin:0;line-height:1.15}
  .date{font-size:clamp(15px,2vw,19px);color:var(--ink);margin:8px 0 0;font-weight:400}
  .controls{display:flex;gap:10px;justify-content:center;flex-wrap:wrap;margin-top:22px;min-height:38px}
  .clock{margin-top:56px}
  .phase{font-size:clamp(22px,3.6vw,32px);font-weight:400;margin:0;letter-spacing:-.01em}
  .time{
    font-size:clamp(64px,14vw,116px);font-weight:400;letter-spacing:-.045em;line-height:1.05;margin:6px 0 0;
    font-variant-numeric:tabular-nums;font-feature-settings:"tnum" 1;
  }
  body.is-break .phase, body.is-break .time{color:var(--green)}
  body.is-paused .phase, body.is-paused .time{color:var(--muted)}
  .sub{margin:18px auto 0;max-width:560px;font-size:15px;color:var(--muted);line-height:1.6;min-height:24px}
  .sub b{color:var(--ink);font-weight:600;font-variant-numeric:tabular-nums}
  body.is-break .sub b{color:var(--green)}
  .done-note{font-size:17px;color:var(--ink);font-weight:500}

  /* ---------- Buttons ---------- */
  button{font:inherit;cursor:pointer;border-radius:8px;transition:background-color .15s,border-color .15s,opacity .15s}
  button:focus-visible{outline:2px solid var(--blue);outline-offset:2px}
  .btn{padding:9px 16px;font-size:14.5px;font-weight:500;border:1px solid var(--line);background:var(--chip);color:var(--ink)}
  .btn:hover:not(:disabled){border-color:var(--muted)}
  .btn-primary{background:var(--blue);border-color:var(--blue);color:#fff;font-weight:600}
  .btn-primary:hover:not(:disabled){filter:brightness(.93)}
  .btn-danger{color:var(--red);background:var(--bg)}
  .btn-danger:hover:not(:disabled){border-color:var(--red)}
  .btn-go{background:var(--green);border-color:var(--green);color:#fff;font-weight:600}
  @media (prefers-color-scheme: dark){ .btn-go{color:#06120d} .btn-primary{color:#06101f} }
  .btn:disabled{opacity:.45;cursor:not-allowed}
  .btn-lg{padding:12px 22px;font-size:16px}
  .btn-link{background:none;border:none;color:var(--muted);font-size:13.5px;text-decoration:underline;text-underline-offset:3px;padding:6px}
  .btn-link:hover{color:var(--ink)}
  .inline{display:inline-flex;align-items:center;gap:8px;padding:0 0 0 12px;font-size:14.5px;font-weight:500;border:1px solid var(--line);border-radius:8px;background:var(--bg)}
  .inline input[type=text]{width:6.4ch;padding:9px 8px;border:none;border-left:1px solid var(--line);border-radius:0 8px 8px 0;font-size:14.5px;text-align:center;background:var(--chip);font-variant-numeric:tabular-nums}
  .inline input[type=text]:focus-visible{outline-offset:-2px}
  .inline input[type=text]:disabled{opacity:.55}
  .controls-note{font-size:13px;color:var(--muted);margin:10px auto 0;max-width:520px;line-height:1.5}

  /* ---------- Break log + utility bar ---------- */
  .log{margin:38px auto 0;max-width:420px;text-align:left;border-top:1px solid var(--line);padding-top:16px}
  .log h2{font-size:13px;font-weight:600;text-transform:uppercase;letter-spacing:.07em;color:var(--muted);margin:0 0 10px}
  .log ul{list-style:none;margin:0;padding:0}
  .log li{display:flex;justify-content:space-between;gap:16px;font-size:14px;padding:6px 0;border-bottom:1px solid var(--line);font-variant-numeric:tabular-nums}
  .log li:last-child{border-bottom:none}
  .log li span:last-child{color:var(--muted)}

  .utils{margin-top:auto;padding-top:32px;display:flex;gap:6px;justify-content:center;flex-wrap:wrap}
  [hidden]{display:none !important}
  @media (max-width:480px){ .wrap{padding:28px 16px 20px} .clock{margin-top:36px} }
  @media (prefers-reduced-motion: reduce){ *{transition:none !important} }
</style>
</head>
<body>
<div id="progress"></div>
<div class="wrap">

  <!-- ================= SETUP ================= -->
  <section class="setup" id="setup">
    <h1>Set up your exam timer</h1>
    <p class="lede">Enter the exam details. The rest-break allowance is worked out from the total exam time (reading + working) and the rules are enforced for you.</p>

    <div class="field">
      <label for="course">Course</label>
      <input type="text" id="course" placeholder="Mathematics Standard 2" autocomplete="off">
    </div>

    <div class="field">
      <label for="date">Exam date</label>
      <input type="date" id="date">
    </div>

    <div class="field">
      <label for="reading">Reading time</label>
      <div class="duo">
        <div><input type="number" id="reading" min="0" max="60" step="1" value="10" inputmode="numeric"></div>
        <div class="unit">minutes</div>
      </div>
      <span class="hint">Set to 0 if this exam has no reading time. Reading time counts towards exam time for the allowance, but rest breaks can only be taken during working time.</span>
    </div>

    <div class="field">
      <label>Working time</label>
      <div class="duo">
        <div><input type="number" id="workH" min="0" max="8" step="1" value="2" inputmode="numeric" aria-label="Working hours"><span class="hint">hours</span></div>
        <div><input type="number" id="workM" min="0" max="59" step="1" value="30" inputmode="numeric" aria-label="Working minutes"><span class="hint">minutes</span></div>
      </div>
    </div>

    <div class="field">
      <label for="rate">Rest-break rate</label>
      <div class="duo">
        <div><input type="number" id="rate" min="0" max="30" step="0.5" value="5" inputmode="decimal"></div>
        <div class="unit">minutes per half hour</div>
      </div>
      <span class="hint">Copy this from your decision letter. The default of 5.0 matches the standard approval.</span>
    </div>

    <div class="allowance">
      <div class="big" id="allowancePreview">Rest-break allowance: 25 minutes</div>
      <div class="note" id="allowanceNote"></div>
    </div>

    <div class="err" id="setupError"></div>
    <button class="btn btn-primary btn-lg" id="btnBuild" style="width:100%">Set up timer</button>
  </section>

  <!-- ================= TIMER ================= -->
  <section class="screen" id="screen" hidden>
    <h1 class="course" id="outCourse"></h1>
    <p class="date" id="outDate"></p>

    <div class="controls">
      <button class="btn btn-primary" id="btnStart">Start reading time</button>
      <button class="btn" id="btnRest" hidden>Start rest break</button>
      <button class="btn btn-danger" id="btnPause" hidden>Pause</button>
      <label class="inline" id="plannedWrap" hidden>Break length
        <input type="text" id="planned" value="05:00" inputmode="numeric" autocomplete="off" spellcheck="false" aria-label="Planned length of this rest break, minutes and seconds">
      </label>
      <button class="btn btn-go" id="btnEndRest" hidden>End rest break</button>
      <button class="btn btn-primary" id="btnResume" hidden>Resume</button>
    </div>
    <p class="controls-note" id="breakNote" hidden></p>

    <div class="clock">
      <p class="phase" id="phase" aria-live="polite">Reading time</p>
      <p class="time" id="time" role="timer">0:10:00</p>
      <p class="sub" id="sub"></p>
      <button class="btn-link" id="btnSkipReading" hidden>Skip to working time</button>
    </div>

    <div class="log" id="log" hidden>
      <h2>Rest breaks taken</h2>
      <ul id="logList"></ul>
    </div>
  </section>

  <div class="utils" id="utils" hidden>
    <button class="btn-link" id="btnFull">Full screen</button>
    <button class="btn-link" id="btnSound">Sound on</button>
    <button class="btn-link" id="btnReset">Reset timer</button>
  </div>
</div>

<script>
(function(){
  "use strict";

  var MIN_BREAK = 5 * 60 * 1000;     // rest breaks can never be shorter than 5 minutes
  var SEC = 1000, MIN = 60000;

  var S = {
    course:"", dateText:"",
    readingTotal:0, workingTotal:0, allowanceTotal:0,
    reading:0, working:0, allowance:0,
    phase:"ready",          // ready | reading | working | break | done
    paused:false,
    thisBreak:0, breaks:[],
    planned:0, breakMax:0, lastPlanned:0,   // this break's target length, the allowance when it began, and the default for the next one
    last:0, ticker:null, sound:true, wakeLock:null
  };

  var $ = function(id){ return document.getElementById(id); };
  var els = {};
  ["setup","screen","utils","course","date","reading","workH","workM","rate","allowancePreview","allowanceNote",
   "setupError","btnBuild","outCourse","outDate","btnStart","btnRest","btnPause","btnEndRest","btnResume",
   "phase","time","sub","btnSkipReading","log","logList","btnFull","btnSound","btnReset","progress",
   "plannedWrap","planned","breakNote"]
   .forEach(function(k){ els[k] = $(k); });

  /* ---------------- helpers ---------------- */

  function clock(ms){
    if (ms < 0) ms = 0;
    var t = Math.ceil(ms / SEC);
    var h = Math.floor(t / 3600), m = Math.floor((t % 3600) / 60), s = t % 60;
    return h + ":" + String(m).padStart(2,"0") + ":" + String(s).padStart(2,"0");
  }
  function mmss(ms){                 // counting down — round up
    if (ms < 0) ms = 0;
    var t = Math.ceil(ms / SEC);
    return Math.floor(t/60) + ":" + String(t%60).padStart(2,"0");
  }
  function elapsed(ms){              // counting up — round down
    if (ms < 0) ms = 0;
    var t = Math.floor(ms / SEC);
    return Math.floor(t/60) + ":" + String(t%60).padStart(2,"0");
  }
  function plural(n, word){ return n + " " + word + (n === 1 ? "" : "s"); }
  function pad2(n){ return String(n).padStart(2,"0"); }
  function fmtMin(n){                // 140 -> "2h 20m", 10 -> "10 min"
    var h = Math.floor(n / 60), m = n % 60;
    return h ? h + "h" + (m ? " " + m + "m" : "") : m + " min";
  }
  function fmtPlanned(ms){           // 05:00 style, for the break-length field
    var t = Math.floor(ms / SEC);
    return pad2(Math.floor(t/60)) + ":" + pad2(t%60);
  }
  function parsePlanned(str){        // accepts "5", "5:00", "05:00", "7:30"; null if unreadable
    var m = String(str).trim().match(/^(\d{1,3})(?::([0-5]?\d))?$/);
    return m ? (+m[1]) * MIN + (+(m[2] || 0)) * SEC : null;
  }

  function longDate(value){
    var parts = String(value).split("-");
    var d = parts.length === 3
      ? new Date(+parts[0], +parts[1]-1, +parts[2])
      : new Date();
    if (isNaN(d.getTime())) d = new Date();
    return d.toLocaleDateString("en-AU", {weekday:"long", day:"numeric", month:"long", year:"numeric"});
  }

  // Allowance = rate for every COMPLETE half hour of exam time (reading + working).
  function allowanceFor(examMinutes, rate){
    return Math.floor(examMinutes / 30) * rate * MIN;
  }

  var audioCtx = null;
  function initAudio(){          // must be called from a user gesture, or beeps may be blocked
    if (audioCtx) return;
    var Ctx = window.AudioContext || window.webkitAudioContext;
    if (!Ctx) return;
    try { audioCtx = new Ctx(); } catch(e){ /* audio unavailable */ }
  }

  function beep(pattern){
    if (!S.sound || !audioCtx) return;
    try {
      if (audioCtx.state === "suspended") audioCtx.resume();
      (pattern || [0]).forEach(function(offset, i){
        var o = audioCtx.createOscillator(), g = audioCtx.createGain();
        var t0 = audioCtx.currentTime + offset;
        o.type = "sine";
        o.frequency.value = 660 + i * 110;
        g.gain.setValueAtTime(0.0001, t0);
        g.gain.exponentialRampToValueAtTime(0.25, t0 + 0.02);
        g.gain.exponentialRampToValueAtTime(0.0001, t0 + 0.42);
        o.connect(g); g.connect(audioCtx.destination);
        o.start(t0); o.stop(t0 + 0.45);
      });
    } catch(e){ /* audio unavailable — the visuals still change */ }
  }

  async function keepAwake(){
    try {
      if ("wakeLock" in navigator && !S.wakeLock){
        S.wakeLock = await navigator.wakeLock.request("screen");
        S.wakeLock.addEventListener("release", function(){ S.wakeLock = null; });
      }
    } catch(e){ /* not supported over file:// — harmless */ }
  }
  document.addEventListener("visibilitychange", function(){
    if (document.visibilityState === "visible" && running()) keepAwake();
  });

  function running(){ return S.phase === "reading" || S.phase === "working" || S.phase === "break"; }

  /* ---------------- setup screen ---------------- */

  function readSetup(){
    var rd = Math.max(0, Math.min(60, Math.floor(+els.reading.value || 0)));
    var h  = Math.max(0, Math.min(8,  Math.floor(+els.workH.value || 0)));
    var m  = Math.max(0, Math.min(59, Math.floor(+els.workM.value || 0)));
    var rate = Math.max(0, Math.min(30, +els.rate.value || 0));
    return { readingMin: rd, workingMin: h*60 + m, rate: rate };
  }

  function previewAllowance(){
    var v = readSetup();
    var examMin = v.readingMin + v.workingMin;
    var halves = Math.floor(examMin / 30);
    var ms = allowanceFor(examMin, v.rate);
    var mins = ms / MIN;

    els.allowancePreview.textContent = "Rest-break allowance: " +
      (ms > 0 ? (Number.isInteger(mins) ? mins : mins.toFixed(1)) + " minutes" : "none");

    var note;
    if (examMin === 0){
      note = "Enter the exam times to see the allowance.";
    } else if (halves === 0){
      note = "The exam time is under half an hour, so no rest-break allowance is generated.";
    } else {
      note = plural(halves, "complete half hour") + " of exam time" +
        (v.readingMin > 0 ? " (" + fmtMin(v.readingMin) + " reading + " + fmtMin(v.workingMin) + " working)" : "") +
        " × " + v.rate + " minutes.";
      var left = examMin % 30;
      if (left > 0) note += " The remaining " + plural(left, "minute") + " doesn't complete a half hour, so it adds nothing.";
      if (ms > 0 && ms < MIN_BREAK) note += " This is under the 5-minute minimum, so no break can actually be taken.";
    }
    els.allowanceNote.textContent = note;
  }

  ["reading","workH","workM","rate"].forEach(function(k){
    els[k].addEventListener("input", previewAllowance);
  });

  els.btnBuild.addEventListener("click", function(){
    initAudio();
    var v = readSetup();
    if (v.workingMin <= 0){
      els.setupError.textContent = "Enter a working time longer than 0 minutes.";
      els.workH.focus();
      return;
    }
    els.setupError.textContent = "";

    S.course        = els.course.value.trim() || "Examination";
    S.dateText      = longDate(els.date.value);
    S.readingTotal  = v.readingMin * MIN;
    S.workingTotal  = v.workingMin * MIN;
    S.allowanceTotal= allowanceFor(v.readingMin + v.workingMin, v.rate);
    S.reading       = S.readingTotal;
    S.working       = S.workingTotal;
    S.allowance     = S.allowanceTotal;
    S.phase         = "ready";
    S.paused        = false;
    S.thisBreak     = 0;
    S.breaks        = [];
    S.lastPlanned   = MIN_BREAK;

    els.outCourse.textContent = S.course;
    els.outDate.textContent   = S.dateText;
    els.btnStart.textContent  = S.readingTotal > 0 ? "Start reading time" : "Start working time";

    els.setup.hidden = true;
    els.screen.hidden = false;
    els.utils.hidden = false;
    document.title = S.course + " — exam timer";
    render();
    els.btnStart.focus();
  });

  /* ---------------- clock engine ---------------- */

  function start(){
    S.last = Date.now();
    if (!S.ticker) S.ticker = setInterval(tick, 200);
    keepAwake();
  }
  function stopTicker(){
    clearInterval(S.ticker); S.ticker = null;
    if (S.wakeLock){ S.wakeLock.release().catch(function(){}); S.wakeLock = null; }
  }

  function tick(){
    var now = Date.now();
    var dt = now - S.last;
    S.last = now;
    if (dt < 0) dt = 0;

    if (!S.paused){
      if (S.phase === "reading"){
        S.reading -= dt;
        if (S.reading <= 0){
          var carry = -S.reading;
          S.reading = 0;
          beginWorking();
          S.working -= carry;
        }
      } else if (S.phase === "break"){
        S.thisBreak += dt;
        S.allowance -= dt;
        if (S.thisBreak >= S.planned || S.allowance <= 0){
          // Cap the break at its planned length (or the allowance, if smaller).
          // Any overshoot in this tick — e.g. the tab was suspended — is charged
          // to working time, never gained.
          var cap  = Math.min(S.planned, S.thisBreak + S.allowance);
          var over = S.thisBreak - cap;
          S.thisBreak  = cap;
          S.allowance += over;
          S.working   -= over;
          endBreak(S.allowance <= 0 ? "allowance" : "planned");
        }
      } else if (S.phase === "working"){
        S.working -= dt;
      }

      if (S.phase === "working" && S.working <= 0){
        S.working = 0;
        S.phase = "done";
        stopTicker();
        beep([0, 0.5, 1.0]);
      }
    }
    render();
  }

  function beginWorking(){
    S.phase = "working";
    beep([0, 0.45]);
  }

  /* ---------------- actions ---------------- */

  els.btnStart.addEventListener("click", function(){
    initAudio();
    if (S.phase !== "ready") return;
    if (S.readingTotal > 0){ S.phase = "reading"; }
    else { S.phase = "working"; }
    start(); render();
  });

  els.btnSkipReading.addEventListener("click", function(){
    if (S.phase !== "reading") return;
    if (!confirm("End reading time now and start the working time?")) return;
    S.reading = 0;
    beginWorking();
    render();
  });

  els.btnPause.addEventListener("click", function(){
    if (!running()) return;
    S.paused = true; render();
  });

  els.btnResume.addEventListener("click", function(){
    if (!S.paused) return;
    S.paused = false; S.last = Date.now(); render();
  });

  els.btnRest.addEventListener("click", function(){
    if (S.phase !== "working" || S.paused) return;
    if (S.allowance < MIN_BREAK) return;          // rule: can't start a break under 5 minutes
    S.phase = "break";
    S.thisBreak = 0;
    S.breakMax = S.allowance;
    // Default to the last length used, capped at what's left (whole seconds).
    S.planned = Math.max(MIN_BREAK, Math.floor(Math.min(S.lastPlanned, S.breakMax) / SEC) * SEC);
    els.planned.value = fmtPlanned(S.planned);
    els.planned.disabled = Math.floor(S.breakMax / SEC) * SEC <= MIN_BREAK;   // only 5:00 is possible
    render();
  });

  // Student changes the planned length mid-break: clamp to the rules, end now if it's already reached.
  function applyPlanned(){
    if (S.phase !== "break") return;
    var v = parsePlanned(els.planned.value);
    if (v !== null){
      S.lastPlanned = Math.min(S.breakMax, Math.max(MIN_BREAK, v));
      S.planned     = Math.max(S.lastPlanned, S.thisBreak);
    }
    els.planned.value = fmtPlanned(S.planned);
    if (S.planned <= S.thisBreak){ endBreak("planned"); return; }
    render();
  }
  els.planned.addEventListener("change", applyPlanned);
  els.planned.addEventListener("keydown", function(e){ if (e.key === "Enter") els.planned.blur(); });

  els.btnEndRest.addEventListener("click", function(){
    if (S.phase !== "break") return;
    if (S.thisBreak < MIN_BREAK) return;   // rule: minimum 5 minutes
    endBreak("manual");
  });

  function endBreak(reason){             // "planned" | "allowance" | "manual"
    S.breaks.push({
      duration: S.thisBreak,
      atWorking: S.working,
      reason: reason
    });
    S.thisBreak = 0;
    S.phase = "working";
    if (reason !== "manual") beep([0, 0.45]);
    renderLog();
    render();
  }

  els.btnReset.addEventListener("click", function(){
    if (running() && !confirm("Reset the timer and go back to the setup screen? The current exam will be lost.")) return;
    stopTicker();
    S.phase = "ready"; S.paused = false;
    document.body.className = "";
    document.title = "Exam timer";
    els.screen.hidden = true;
    els.utils.hidden = true;
    els.log.hidden = true;
    els.logList.innerHTML = "";
    els.progress.style.width = "0";
    els.setup.hidden = false;
    els.course.focus();
  });

  els.btnSound.addEventListener("click", function(){
    initAudio();
    S.sound = !S.sound;
    els.btnSound.textContent = S.sound ? "Sound on" : "Sound off";
    if (S.sound) beep([0]);
  });

  els.btnFull.addEventListener("click", function(){
    if (document.fullscreenElement) document.exitFullscreen();
    else document.documentElement.requestFullscreen().catch(function(){});
  });
  document.addEventListener("fullscreenchange", function(){
    els.btnFull.textContent = document.fullscreenElement ? "Exit full screen" : "Full screen";
  });

  window.addEventListener("beforeunload", function(e){
    if (running()){ e.preventDefault(); e.returnValue = ""; }
  });

  /* ---------------- rendering ---------------- */

  function show(el, on){ el.hidden = !on; }
  function setText(el, str){ if (el.textContent !== str) el.textContent = str; }
  function setHTML(el, str){ if (el.__html !== str){ el.__html = str; el.innerHTML = str; } }

  function render(){
    var p = S.phase, paused = S.paused;

    document.body.className = paused ? "is-paused" : (p === "break" ? "is-break" : "");

    // Controls
    show(els.btnStart,  p === "ready");
    show(els.btnRest,   p === "working" && !paused);
    show(els.btnEndRest, p === "break" && !paused);
    show(els.plannedWrap, p === "break" && !paused);
    show(els.breakNote,  p === "break");
    show(els.btnPause,  running() && !paused);
    show(els.btnResume, paused);
    show(els.btnSkipReading, p === "reading" && !paused);

    // Clock face
    if (p === "ready"){
      setText(els.phase, S.readingTotal > 0 ? "Reading time" : "Working time");
      setText(els.time, clock(S.readingTotal > 0 ? S.readingTotal : S.workingTotal));
      setHTML(els.sub, S.allowanceTotal > 0
        ? "Rest-break allowance <b>" + mmss(S.allowanceTotal) + "</b> · available once working time starts"
        : "No rest-break allowance for this exam.");
    }
    else if (p === "reading"){
      setText(els.phase, paused ? "Reading time (paused)" : "Reading time");
      setText(els.time, clock(S.reading));
      setHTML(els.sub, "Working time starts automatically. Rest breaks can't be taken during reading time.");
    }
    else if (p === "working"){
      setText(els.phase, paused ? "Working time (paused)" : "Working time left");
      setText(els.time, clock(S.working));
      if (S.allowanceTotal === 0){
        setHTML(els.sub, "No rest-break allowance for this exam.");
      } else if (S.allowance < MIN_BREAK){
        setHTML(els.sub, "Rest-break allowance <b>" + mmss(S.allowance) + "</b> left — under the 5-minute minimum, so no further breaks can be taken.");
      } else {
        setHTML(els.sub, "Rest-break allowance <b>" + mmss(S.allowance) + "</b> left of " + mmss(S.allowanceTotal) +
          " · " + plural(S.breaks.length, "break") + " taken");
      }
      els.btnRest.disabled = S.allowance < MIN_BREAK;
      els.btnRest.title    = S.allowance < MIN_BREAK ? "Less than 5 minutes of allowance remains" : "";
    }
    else if (p === "break"){
      setText(els.phase, paused ? "Rest break (paused)" : "Rest break");
      setText(els.time, clock(S.planned - S.thisBreak));
      var canEnd = S.thisBreak >= MIN_BREAK;
      els.btnEndRest.disabled = !canEnd;
      setText(els.btnEndRest, canEnd ? "End rest break now" : "End early after 5:00");
      setHTML(els.sub, "This break <b>" + elapsed(S.thisBreak) + "</b> of " + mmss(S.planned) +
        " · allowance after it <b>" + mmss(S.breakMax - S.planned) + "</b> · working time held at " + clock(S.working));
      setText(els.breakNote, els.planned.disabled
        ? "Only 5:00 of allowance remains, so this break is fixed at 5:00."
        : "The break ends on its own when the planned length runs out. Change it any time, between 5:00 and " + elapsed(S.breakMax) + ".");
    }
    else if (p === "done"){
      setText(els.phase, "Working time is over");
      setText(els.time, "0:00:00");
      var used = S.allowanceTotal - S.allowance;
      setHTML(els.sub, S.allowanceTotal > 0
        ? "<span class='done-note'>Pens down.</span><br>" + plural(S.breaks.length, "rest break") + " taken, " +
          mmss(used) + " of the " + mmss(S.allowanceTotal) + " allowance used."
        : "<span class='done-note'>Pens down.</span>");
    }

    // Progress bar tracks working time
    var pct = 0;
    if (p === "reading" || p === "ready") pct = 0;
    else if (S.workingTotal > 0) pct = (1 - S.working / S.workingTotal) * 100;
    if (p === "done") pct = 100;
    els.progress.style.width = pct + "%";
  }

  function renderLog(){
    if (!S.breaks.length){ els.log.hidden = true; return; }
    els.log.hidden = false;
    els.logList.innerHTML = "";
    S.breaks.forEach(function(b, i){
      var li = document.createElement("li");
      var a = document.createElement("span");
      a.textContent = "Break " + (i+1) + " — " + elapsed(b.duration);
      var c = document.createElement("span");
      c.textContent = "at " + clock(b.atWorking) + " remaining" + (b.reason === "allowance" ? " · allowance used up" : "");
      li.appendChild(a); li.appendChild(c);
      els.logList.appendChild(li);
    });
  }

  /* ---------------- init ---------------- */
  (function init(){
    var now = new Date();
    els.date.value = now.getFullYear() + "-" + String(now.getMonth()+1).padStart(2,"0") + "-" + String(now.getDate()).padStart(2,"0");
    if (!document.documentElement.requestFullscreen) els.btnFull.hidden = true;
    previewAllowance();
  })();
})();
</script>
</body>
</html>
